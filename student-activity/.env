APP_ADDR=:8080                 # адрес HTTP-сервера
APP_HOST=localhost:8080        # хост для ссылок iCal/CalDAV (на сервере — ваш домен)
DB_PATH=data/app.db            # файл SQLite
UPLOAD_DIR=data/uploads        # архив загруженных CSV
ADMIN_LOGIN=admin              # логин админа (создаётся ОДИН раз, если админа нет в БД)
ADMIN_PASSWORD=admin123        # пароль админа (в БД уходит только bcrypt-хеш)
SEMESTER_START=2026-09-01      # якорь семестра: от него считаем числитель/знаменатель
SEMESTER_END=2026-12-31        # конец действия расписания (RRULE UNTIL)